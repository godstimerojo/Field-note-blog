<%- include('partials/header') %>
  <section class="hero">
    <p class="eyebrow">Personal writing space</p>
    <h1>Notes from<br /><em>the margin.</em></h1>
    <p class="intro">A quiet collection of ideas, observations, and unfinished thoughts.</p>
  </section>

  <section class="post-list" aria-label="Posts">
    <div class="section-heading">
      <p>All posts</p>
      <span><%= posts.length %> <%= posts.length === 1 ? 'entry' : 'entries' %></span>
    </div>
    <% if (posts.length) { %>
      <% posts.forEach((post) => { %>
        <article class="post-card">
          <div class="post-meta"><%= formatDate(post.createdAt) %></div>
          <div class="post-body">
            <h2><%= post.title %></h2>
            <p><%= post.content %></p>
            <div class="post-actions">
              <a href="/posts/<%= post.id %>/edit">Edit</a>
              <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this post?');">
                <button type="submit">Delete</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <p class="eyebrow">Your notebook is open</p>
        <h2>Nothing here yet.</h2>
        <p>Start with one honest sentence. You can always revise it later.</p>
        <a class="text-link" href="/posts/new">Write your first post →</a>
      </div>
    <% } %>
  </section>
<%- include('partials/footer') %>
